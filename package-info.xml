<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "https://www.elkarte.net/site/package-info">
<package-info xmlns="https://www.elkarte.net/site/package-info" xmlns:elk="https://www.elkarte.net/">
	<id>Spuds:DescriptiveLinks</id>
	<name>Descriptive Links</name>
	<version>2.0.0</version>
	<type>modification</type>
	<license><![CDATA[
/**
 * Descriptive Links
 *
 * @author spuds
 * @license MPL 1.1 https://mozilla.org/MPL/1.1/
 *
 * @version 2.0.0
 */
]]></license>
	<install for="2.0.0 Beta 2 - 2.0.99">
		<database>add_settings.php</database>
		<readme type="file" parsebbc="true">readme.txt</readme>
		<require-dir name="DescriptiveLinks" destination="ADDONSDIR" />
		<hook hook="integrate_sa_modify_modifications" file="ADDONSDIR/DescriptiveLinks/DescriptiveLinksIntegrate.php" function="imm_descriptive_links" />
		<hook hook="integrate_admin_areas" file="ADDONSDIR/DescriptiveLinks/DescriptiveLinksIntegrate.php" function="iaa_descriptive_links" />
		<hook hook="integrate_preparse_tokenized_code" file="ADDONSDIR/DescriptiveLinks/DescriptiveLinksIntegrate.php" function="ipc_descriptive_links" />
		<modification>language.xml</modification>
		<redirect url="?action=admin;area=addonsettings;sa=dlinks" timeout="5000">redirect.txt</redirect>
	</install>

	<uninstall for="2.0.0 Beta 2 - 2.0.99">
		<readme type="file" parsebbc="true">readme-uninstall.txt</readme>
		<hook reverse="true" hook="integrate_sa_modify_modifications" file="ADDONSDIR/DescriptiveLinks/DescriptiveLinksIntegrate.php" function="imm_descriptive_links" />
		<hook reverse="true" hook="integrate_admin_areas" file="ADDONSDIR/DescriptiveLinks/DescriptiveLinksIntegrate.php" function="iaa_descriptive_links" />
		<hook reverse="true" hook="integrate_preparse_tokenized_code" file="ADDONSDIR/DescriptiveLinks/DescriptiveLinksIntegrate.php" function="ipc_descriptive_links" />
		<modification type="file" reverse="true">language.xml</modification>
		<remove-dir name="ADDONSDIR/DescriptiveLinks" />
	</uninstall>

</package-info>
